# Copy to .env next to compose.yaml. All values below are placeholders: replace every one.

# External base URL clients use. The OAuth issuer and every resource URI derive from it. Use https in any shared setup.
BASTION_PUBLIC_URL=http://localhost:8080

# Break-glass admin created on first start (BASTION_BOOTSTRAP_ADMIN_EMAIL; more admins: docker compose exec bastion bastion create-admin --email ...).
BASTION_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Postgres password (also embedded in BASTION_DATABASE_URL by compose.yaml).
POSTGRES_PASSWORD=change-me

# 32+ random bytes for internal RPC signing (21.2): openssl rand -base64 48
BASTION_INTERNAL_SECRET=change-me-to-at-least-32-random-bytes

# Image selection. Pin a release tag (or digest) for anything but a quick look.
BASTION_IMAGE=ghcr.io/bastion-mcp/bastion
BASTION_VERSION=latest

# Host port mapped to the container's 8080.
BASTION_HTTP_PORT_HOST=8080

BASTION_LOG_LEVEL=info
