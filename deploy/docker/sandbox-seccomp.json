{
  "$comment": "Bastion sandbox jail filter (tdd 8.5). Denylist in Docker profile format. packages/sandbox compiles it to BPF at startup for bwrap --seccomp. Semantics of SCMP_CMP_MASKED_EQ: (arg & value) == valueTwo. x32 ABI numbers are always killed by the generator.",
  "defaultAction": "SCMP_ACT_ALLOW",
  "syscalls": [
    {
      "names": ["ptrace", "process_vm_readv", "process_vm_writev"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1,
      "comment": "No tracing of other processes"
    },
    {
      "names": [
        "mount",
        "umount2",
        "pivot_root",
        "chroot",
        "mount_setattr",
        "move_mount",
        "open_tree",
        "fsopen",
        "fsconfig",
        "fsmount",
        "fspick"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1,
      "comment": "No filesystem mounting or root changes"
    },
    {
      "names": ["keyctl", "add_key", "request_key"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1,
      "comment": "No kernel keyring"
    },
    {
      "names": ["bpf", "userfaultfd", "perf_event_open"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1,
      "comment": "No bpf, userfaultfd or perf events"
    },
    {
      "names": [
        "kexec_load",
        "kexec_file_load",
        "init_module",
        "finit_module",
        "delete_module",
        "reboot",
        "swapon",
        "swapoff",
        "acct",
        "iopl",
        "ioperm",
        "quotactl",
        "lookup_dcookie"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1,
      "comment": "No kernel or system administration"
    },
    {
      "names": ["name_to_handle_at", "open_by_handle_at"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1,
      "comment": "No file handle escapes"
    },
    {
      "names": ["setns"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1,
      "comment": "No joining namespaces"
    },
    {
      "names": ["clone3"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 38,
      "comment": "clone3 flags live in memory and cannot be inspected; ENOSYS makes glibc fall back to clone"
    },
    {
      "names": ["clone", "unshare"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1,
      "comment": "No namespace creation: CLONE_NEWNS",
      "args": [
        {
          "index": 0,
          "value": 131072,
          "valueTwo": 131072,
          "op": "SCMP_CMP_MASKED_EQ"
        }
      ]
    },
    {
      "names": ["clone", "unshare"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1,
      "comment": "No namespace creation: CLONE_NEWCGROUP",
      "args": [
        {
          "index": 0,
          "value": 33554432,
          "valueTwo": 33554432,
          "op": "SCMP_CMP_MASKED_EQ"
        }
      ]
    },
    {
      "names": ["clone", "unshare"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1,
