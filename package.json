{
  "name": "bastion",
  "private": true,
  "version": "0.0.0",
  "description": "Bastion: self-hosted enterprise MCP gateway",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "boundaries": "depcruise packages --config .dependency-cruiser.cjs",
    "db:generate": "pnpm --filter @bastion-mcp/db generate",
    "db:migrate": "pnpm --filter @bastion-mcp/db migrate:dev",
    "check": "pnpm lint && pnpm typecheck && pnpm boundaries && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "3.2.7",
    "dependency-cruiser": "18.5.0",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "turbo": "2.11.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
