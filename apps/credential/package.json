{
  "name": "bastion-credential",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "bastion-credential": "./src/main.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "bun build --compile --minify src/main.ts --outfile dist/bastion-credential",
    "build:targets": "node scripts/build-targets.mjs"
  },
  "dependencies": {
    "@bastion-mcp/core": "workspace:*",
    "@napi-rs/keyring": "2.1.0",
    "zod": "4.6.5"
  }
}
