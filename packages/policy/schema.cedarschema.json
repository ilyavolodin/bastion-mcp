{
  "Bastion": {
    "commonTypes": {
      "McpContext": {
        "type": "Record",
        "attributes": {
          "clientId": {
            "type": "String",
            "required": true
          },
          "clientName": {
            "type": "String",
            "required": true
          },
          "ip": {
            "type": "Extension",
            "name": "ipaddr",
            "required": true
          },
          "authMethod": {
            "type": "String",
            "required": true
          },
          "hour": {
            "type": "Long",
            "required": true
          },
          "weekday": {
            "type": "Long",
            "required": true
          },
          "endpoint": {
            "type": "String",
            "required": true
          },
          "call": {
            "type": "EntityOrCommon",
            "name": "ToolCall",
            "required": false
          }
        }
      }
    },
    "entityTypes": {
      "Org": {},
      "Team": {
        "memberOfTypes": ["Org"],
        "shape": {
          "type": "Record",
          "attributes": {
            "slug": {
              "type": "String",
              "required": true
            }
          }
        }
      },
      "User": {
        "memberOfTypes": ["Team", "Org"],
        "shape": {
          "type": "Record",
          "attributes": {
            "role": {
              "type": "String",
              "required": true
            },
            "active": {
              "type": "Boolean",
              "required": true
            },
            "emailDomain": {
              "type": "String",
              "required": true
            },
            "managedTeams": {
              "type": "Set",
              "element": {
                "type": "EntityOrCommon",
                "name": "Team"
              },
              "required": true
            }
          }
        }
      },
      "ServiceAccount": {
        "memberOfTypes": ["Team", "Org"],
        "shape": {
          "type": "Record",
          "attributes": {
            "active": {
              "type": "Boolean",
              "required": true
            }
          }
        }
      },
      "CatalogEntry": {
        "memberOfTypes": ["Org"],
        "shape": {
          "type": "Record",
          "attributes": {
            "ownerTeam": {
              "type": "EntityOrCommon",
              "name": "Team",
              "required": false
            },
            "visibility": {
              "type": "String",
              "required": true
            },
            "risk": {
              "type": "String",
              "required": true
            }
          }
        }
      },
      "Installation": {
        "memberOfTypes": ["CatalogEntry"],
        "shape": {
          "type": "Record",
          "attributes": {
            "ownerUser": {
              "type": "EntityOrCommon",
              "name": "User",
              "required": false
            },
            "ownerTeam": {
              "type": "EntityOrCommon",
              "name": "Team",
              "required": false
            },
            "ownerService": {
              "type": "EntityOrCommon",
              "name": "ServiceAccount",
              "required": false
            },
            "scope": {
              "type": "String",
              "required": true
            }
          }
        }
      },
      "Tool": {
        "memberOfTypes": ["Installation"],
        "shape": {
          "type": "Record",
          "attributes": {
            "name": {
              "type": "String",
              "required": true
            },
            "readOnly": {
              "type": "Boolean",
              "required": true
            },
            "destructive": {
              "type": "Boolean",
              "required": true
            },
            "openWorld": {
              "type": "Boolean",
              "required": true
            }
          }
        }
      },
      "Prompt": {
        "memberOfTypes": ["Installation"],
        "shape": {
          "type": "Record",
          "attributes": {
            "name": {
              "type": "String",
              "required": true
            }
          }
        }
      },
      "Resource": {
        "memberOfTypes": ["Installation"],
        "shape": {
          "type": "Record",
          "attributes": {
            "uri": {
              "type": "String",
              "required": true
            }
          }
        }
      },
      "Endpoint": {
        "shape": {
          "type": "Record",
          "attributes": {
            "owner": {
              "type": "EntityOrCommon",
              "name": "User",
              "required": true
            }
          }
        }
      },
      "ToolCall": {
        "tags": {
          "type": "String"
        }
      }
    },
    "actions": {
      "useInstallation": {
        "appliesTo": {
          "principalTypes": ["User", "ServiceAccount"],
          "resourceTypes": ["Installation"],
          "context": {
            "type": "McpContext"
          }
        }
      },
      "seeTool": {
        "appliesTo": {
          "principalTypes": ["User", "ServiceAccount"],
          "resourceTypes": ["Tool"],
          "context": {
            "type": "McpContext"
